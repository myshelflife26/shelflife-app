rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isManagement() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'management' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    function isTradeTransfer() {
      return isSignedIn() &&
             request.resource.data.userId != resource.data.userId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt', 'isPublic', 'isListed', 'marketplaceListing', 'availability']);
    }

    match /masterFigures/{figureId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isManagement();
    }

    match /figures/{figureId} {
      // UPDATED: Allow unauthenticated users to read public/listed figures
      allow read: if resource.data.isPublic == true ||
                     resource.data.isListed == true ||
                     (isSignedIn() && resource.data.userId == request.auth.uid) ||
                     isManagement();

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isManagement();

      allow update: if isTradeTransfer();
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // Conversations (new threaded messaging system)
    match /conversations/{conversationId} {
      // Users can read conversations if they are participants
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Users can create conversations if they are one of the participants
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Users can update conversations if they are participants (for marking as read, archiving)
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Users can delete their own conversations
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Messages subcollection within conversations
      match /messages/{messageId} {
        // Users can read messages if they are participants of the parent conversation
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Users can create messages if they are participants and the message is from them
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.fromUserId == request.auth.uid;

        // Users can update their own messages (for editing/read receipts)
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Users can delete their own messages
        allow delete: if isSignedIn() &&
          resource.data.fromUserId == request.auth.uid;
      }
    }

    match /communityFigures/{figureId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /trades/{tradeId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    match /admirer_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.admirerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.admirerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.admirerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );
    }

    match /admirers/{relationshipId} {
      // Allow all signed-in users to read (for admirer counts)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.admirerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );
    }

    match /userRatings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    match /shelves/{shelfId} {
      allow read: if isSignedIn() && (
        resource.data.isPublic == true ||
        resource.data.userId == request.auth.uid ||
        isManagement()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isManagement()
      );
    }

    match /wishlist/{itemId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isManagement()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isManagement()
      );
    }

    match /rejectedDuplicates/{rejectionId} {
      allow read: if isSignedIn();
      allow create, delete: if isManagement();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isManagement();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
